# supabase
supabase/.temp/

# node / next
node_modules/
.next/
out/
dist/
*.tsbuildinfo
coverage/

# OS
.DS_Store
Icon?
# public/icons holds app icons (SVG); on case-insensitive FS, macOS "Icon?" pattern above would ignore it
!public/icons/
Thumbs.db

# nguồn học có bản quyền / media (chỉ giữ metadata + trích đoạn ngắn trong repo)
content/english-lab/**/*.pdf
content/english-lab/**/*.mp3
content/english-lab/**/*.m4a
content/english-lab/**/*.wav
content/english-lab/**/*.mp4

# dữ liệu học riêng, backup local
private/
backups/
backups/*.sql
# Chỉ ignore SQL trong thư mục backups, KHÔNG ignore migration files
!src/db/migrations/**/*.sql
!supabase/migrations/**/*.sql
.vercel
.env*
