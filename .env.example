# Copy thành .env.local và điền giá trị thật. KHÔNG commit .env.local.
# Các giá trị dưới đây chỉ là mẫu giả.

# Supabase — bắt buộc
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
# Tuỳ chọn: một số thao tác server/storage dùng service role key
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Postgres — cần ít nhất một trong hai biến
DATABASE_URL=postgresql://user:password@host:5432/postgres
# POSTGRES_URL=postgresql://user:password@host:5432/postgres

# Gemini — bắt buộc cho chức năng chấm bài/AI
GEMINI_API_KEY=replace-me

# Google Drive sync (tuỳ chọn — chỉ cần nếu dùng /admin sync Drive)
# Nén JSON service account thành 1 dòng, không dán private key thật vào file này.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}
# GOOGLE_DRIVE_FOLDER_ID=replace-me

# Bảo mật/dev (tuỳ chọn)
# Danh sách email được phép đăng nhập, cách nhau bằng dấu phẩy
# ALLOWED_EMAILS=you@example.com
# Chỉ dùng local development, không bật trên production
# DEV_BYPASS_AUTH=false
